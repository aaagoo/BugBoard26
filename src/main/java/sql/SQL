CREATE OR REPLACE FUNCTION trova_utente_libero(
    p_creatore_escluso VARCHAR(50)
)
RETURNS VARCHAR(50) AS $$
DECLARE
    v_utente VARCHAR(50);
BEGIN
    SELECT nomeUtente INTO v_utente
    FROM account
    WHERE ruolo = 'UTENTE'::ruolo_enum
      AND nomeUtente != p_creatore_escluso
    ORDER BY issueAssegnate ASC
    LIMIT 1;

    IF FOUND THEN
        RETURN v_utente;
    END IF;

    SELECT nomeUtente INTO v_utente
    FROM account
    WHERE ruolo = 'UTENTE'::ruolo_enum
    ORDER BY issueAssegnate ASC
    LIMIT 1;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Nessun utente disponibile';
    END IF;

    RETURN v_utente;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION modifica_issue(
    p_issue_id BIGINT,
    p_titolo VARCHAR(100),
    p_descrizione TEXT,
    p_priorita priorita_enum,
    p_tipo tipo_enum,
    p_assegnatario VARCHAR(50),
    p_immagine TEXT,
    p_richiedente VARCHAR
) RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR) AS $$
DECLARE
    v_vecchio_assegnatario VARCHAR(50);
    v_vecchia_priorita priorita_enum;
    v_creatore VARCHAR(50);
    v_risolto BOOLEAN;
    v_ruolo_richiedente ruolo_enum;
    v_peso_vecchio INT;
    v_peso_nuovo INT;
BEGIN
    SELECT assegnatarioUsername, creatoreUsername, priorita, risolto
    INTO v_vecchio_assegnatario, v_creatore, v_vecchia_priorita, v_risolto
    FROM issue
    WHERE id = p_issue_id;

    IF NOT FOUND THEN
        RETURN QUERY SELECT false::BOOLEAN, 'Issue non trovata'::VARCHAR;
        RETURN;
    END IF;

    SELECT ruolo INTO v_ruolo_richiedente FROM account WHERE nomeUtente = p_richiedente;
    IF v_creatore != p_richiedente AND v_ruolo_richiedente != 'AMMINISTRATORE' THEN
        RETURN QUERY SELECT false::BOOLEAN, 'Non sei autorizzato a modificare questa issue'::VARCHAR;
        RETURN;
    END IF;

    IF v_risolto = FALSE THEN
        v_peso_vecchio := CASE v_vecchia_priorita
            WHEN 'LOW' THEN 1 WHEN 'MEDIUM' THEN 2 WHEN 'HIGH' THEN 3 WHEN 'CRITICAL' THEN 4 END;

        v_peso_nuovo := CASE p_priorita
            WHEN 'LOW' THEN 1 WHEN 'MEDIUM' THEN 2 WHEN 'HIGH' THEN 3 WHEN 'CRITICAL' THEN 4 END;

        IF v_vecchio_assegnatario IS DISTINCT FROM p_assegnatario THEN
            IF v_vecchio_assegnatario IS NOT NULL THEN
                UPDATE account SET issueAssegnate = issueAssegnate - v_peso_vecchio WHERE nomeUtente = v_vecchio_assegnatario;
            END IF;
            IF p_assegnatario IS NOT NULL THEN
                UPDATE account SET issueAssegnate = issueAssegnate + v_peso_nuovo WHERE nomeUtente = p_assegnatario;

                INSERT INTO notifica (destinatarioUsername, messaggio, dataCreazione)
                VALUES (p_assegnatario, 'Ti è stata assegnata la issue: "' || p_titolo || '"', timezone('Europe/Rome', NOW()::timestamptz));
            END IF;

        ELSIF v_peso_vecchio != v_peso_nuovo AND p_assegnatario IS NOT NULL THEN
            UPDATE account SET issueAssegnate = issueAssegnate - v_peso_vecchio + v_peso_nuovo WHERE nomeUtente = p_assegnatario;
        END IF;
    END IF;

    UPDATE issue
    SET titolo = p_titolo,
        descrizione = p_descrizione,
        priorita = p_priorita,
        tipo = p_tipo,
        assegnatarioUsername = p_assegnatario,
        immagineUrl = COALESCE(p_immagine, immagineUrl)
    WHERE id = p_issue_id;

    RETURN QUERY SELECT true::BOOLEAN, 'Issue modificata con successo'::VARCHAR;

EXCEPTION
    WHEN others THEN
        RETURN QUERY SELECT false::BOOLEAN, ('Errore: ' || SQLERRM)::VARCHAR;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION get_notifiche(
    p_username VARCHAR(50)
)
RETURNS TABLE(
    id BIGINT,
    messaggio TEXT,
    letta BOOLEAN,
    dataCreazione TIMESTAMP
) AS $$
BEGIN
    RETURN QUERY
    SELECT n.id, n.messaggio, n.letta, n.dataCreazione
    FROM notifica n
    WHERE n.destinatarioUsername = p_username
    ORDER BY n.dataCreazione DESC;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION segna_notifica_letta(
    p_notifica_id BIGINT
)
RETURNS VOID AS $$
BEGIN
    UPDATE notifica
    SET letta = TRUE
    WHERE id = p_notifica_id;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION conta_notifiche_non_lette(
    p_username VARCHAR(50)
)
RETURNS INT AS $$
DECLARE
    v_count INT;
BEGIN
    SELECT COUNT(*) INTO v_count
    FROM notifica
    WHERE destinatarioUsername = p_username AND letta = FALSE;
    RETURN v_count;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION mantieni_limite_notifiche()
RETURNS TRIGGER AS $$
BEGIN
    DELETE FROM notifica
    WHERE id IN (
        SELECT id
        FROM notifica
        WHERE destinatarioUsername = NEW.destinatarioUsername
        ORDER BY dataCreazione DESC
        OFFSET 50
    );
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_limite_notifiche
AFTER INSERT ON notifica
FOR EACH ROW
EXECUTE FUNCTION mantieni_limite_notifiche();
