CREATE OR REPLACE FUNCTION trova_utente_libero()
RETURNS VARCHAR(50) AS $$
DECLARE
    v_utente VARCHAR(50);
BEGIN
    SELECT nomeUtente INTO v_utente
    FROM account
    WHERE ruolo = 'UTENTE'::ruolo_enum
    ORDER BY issueAssegnate ASC
    LIMIT 1;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Nessun utente disponibile';
    END IF;

    RETURN v_utente;
END;
$$ LANGUAGE plpgsql;

