CREATE TYPE ruolo_enum AS ENUM ('UTENTE', 'AMMINISTRATORE');

CREATE TABLE account (
    nomeUtente VARCHAR(50) PRIMARY KEY,
    password VARCHAR(50) NOT NULL,
    nome VARCHAR(20) NOT NULL,
    cognome VARCHAR(20) NOT NULL,
    email VARCHAR(50) NOT NULL UNIQUE,
    ruolo ruolo_enum NOT NULL,
    avatar VARCHAR(50) NOT NULL,
    issueAssegnate INT DEFAULT 0
);

CREATE TYPE priorita_enum AS ENUM ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL');

CREATE TYPE tipo_enum AS ENUM ('QUESTION', 'BUG', 'DOCUMENTATION', 'FEATURE');

CREATE TABLE issue (
    id BIGSERIAL PRIMARY KEY,
    titolo VARCHAR(100) NOT NULL,
    descrizione TEXT,
    priorita priorita_enum NOT NULL,
    tipo tipo_enum NOT NULL,
    immagineUrl TEXT,
    creatoreUsername VARCHAR(50) NOT NULL,
    assegnatarioUsername VARCHAR(50),
    dataCreazione TIMESTAMP NOT NULL DEFAULT (timezone('Europe/Rome', NOW()::timestamptz)),
    risolto BOOLEAN NOT NULL DEFAULT FALSE,
    dataRisoluzione TIMESTAMP,
    FOREIGN KEY (creatoreUsername) REFERENCES account(nomeUtente),
    FOREIGN KEY (assegnatarioUsername) REFERENCES account(nomeUtente)
);

CREATE TABLE notifica (
    id BIGSERIAL PRIMARY KEY,
    destinatarioUsername VARCHAR(50) NOT NULL,
    messaggio TEXT NOT NULL,
    letta BOOLEAN NOT NULL DEFAULT FALSE,
    dataCreazione TIMESTAMP NOT NULL DEFAULT (timezone('Europe/Rome', NOW()::timestamptz)),
    FOREIGN KEY (destinatarioUsername) REFERENCES account(nomeUtente) ON DELETE CASCADE
);


CREATE OR REPLACE FUNCTION crea_account(
    p_nomeUtente VARCHAR,
    p_password VARCHAR,
    p_nome VARCHAR,
    p_cognome VARCHAR,
    p_email VARCHAR,
    p_ruolo ruolo_enum,
    p_avatar VARCHAR
)
RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR) AS $$
BEGIN
    INSERT INTO account (nomeUtente, password, nome, cognome, email, ruolo, avatar, issueAssegnate)
    VALUES (p_nomeUtente, p_password, p_nome, p_cognome, p_email, p_ruolo, p_avatar, 0);

    RETURN QUERY SELECT true::BOOLEAN, 'Account creato con successo'::VARCHAR;

EXCEPTION
    WHEN unique_violation THEN
        RETURN QUERY SELECT false::BOOLEAN, 'NomeUtente o Email già esistente'::VARCHAR;
    WHEN others THEN
        RETURN QUERY SELECT false::BOOLEAN, ('Errore: ' || SQLERRM)::VARCHAR;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION login(
    p_nomeUtente VARCHAR,
    p_password VARCHAR
)
RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR, ruolo ruolo_enum) AS $$
BEGIN
    IF EXISTS (SELECT 1 FROM account WHERE nomeUtente = p_nomeUtente AND password = p_password) THEN
        RETURN QUERY
        SELECT
            true::BOOLEAN,
            'Login effettuato con successo'::VARCHAR,
            a.ruolo
        FROM account a
        WHERE a.nomeUtente = p_nomeUtente;
    ELSE
        RETURN QUERY
        SELECT
            false::BOOLEAN,
            'NomeUtente o password errati'::VARCHAR,
            NULL::ruolo_enum;
    END IF;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION get_all_accounts()
RETURNS TABLE(
    nomeUtente VARCHAR,
    password VARCHAR,
    nome VARCHAR,
    cognome VARCHAR,
    email VARCHAR,
    ruolo ruolo_enum,
    avatar VARCHAR,
    issueAssegnate INT
) AS $$
BEGIN
    RETURN QUERY
    SELECT
        a.nomeUtente,
        a.password,
        a.nome,
        a.cognome,
        a.email,
        a.ruolo,
        a.avatar,
        a.issueAssegnate
    FROM account a
    ORDER BY a.ruolo DESC, a.nomeUtente ASC;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION elimina_account(
    p_nomeUtente VARCHAR
)
RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR) AS $$
DECLARE
    v_count INT;
    v_ruolo ruolo_enum;
BEGIN
    SELECT COUNT(*) INTO v_count FROM issue WHERE creatoreUsername = p_nomeUtente;
    IF v_count > 0 THEN
        RETURN QUERY SELECT false::BOOLEAN, 'Impossibile eliminare: l''utente ha creato delle issue.'::VARCHAR;
        RETURN;
    END IF;

    SELECT COUNT(*) INTO v_count FROM issue WHERE assegnatarioUsername = p_nomeUtente;
    IF v_count > 0 THEN
        RETURN QUERY SELECT false::BOOLEAN, 'Impossibile eliminare: l''utente ha delle issue assegnate.'::VARCHAR;
        RETURN;
    END IF;

    SELECT ruolo INTO v_ruolo FROM account WHERE nomeUtente = p_nomeUtente;
    IF v_ruolo = 'AMMINISTRATORE' THEN
        SELECT COUNT(*) INTO v_count FROM account WHERE ruolo = 'AMMINISTRATORE';
        IF v_count <= 1 THEN
            RETURN QUERY SELECT false::BOOLEAN, 'Impossibile eliminare: è l''unico amministratore rimasto.'::VARCHAR;
            RETURN;
        END IF;
    END IF;

    DELETE FROM account WHERE nomeUtente = p_nomeUtente;

    IF FOUND THEN
        RETURN QUERY SELECT true::BOOLEAN, 'Account eliminato con successo'::VARCHAR;
    ELSE
        RETURN QUERY SELECT false::BOOLEAN, 'Account non trovato'::VARCHAR;
    END IF;

EXCEPTION
    WHEN others THEN
        RETURN QUERY SELECT false::BOOLEAN, ('Errore: ' || SQLERRM)::VARCHAR;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION modifica_account(
    p_nomeUtente VARCHAR,
    p_password VARCHAR,
    p_nome VARCHAR,
    p_cognome VARCHAR,
    p_email VARCHAR,
    p_avatar VARCHAR
)
RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR) AS $$
BEGIN
    UPDATE account
    SET
        password = COALESCE(NULLIF(p_password, ''), password),
        nome = COALESCE(NULLIF(p_nome, ''), nome),
        cognome = COALESCE(NULLIF(p_cognome, ''), cognome),
        email = COALESCE(NULLIF(p_email, ''), email),
        avatar = COALESCE(NULLIF(p_avatar, ''), avatar)
    WHERE nomeUtente = p_nomeUtente;

    IF FOUND THEN
        RETURN QUERY SELECT true::BOOLEAN, 'Account modificato con successo'::VARCHAR;
    ELSE
        RETURN QUERY SELECT false::BOOLEAN, 'Account non trovato'::VARCHAR;
    END IF;

EXCEPTION
    WHEN unique_violation THEN
        RETURN QUERY SELECT false::BOOLEAN, 'Email già esistente'::VARCHAR;
    WHEN others THEN
        RETURN QUERY SELECT false::BOOLEAN, ('Errore: ' || SQLERRM)::VARCHAR;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION crea_issue(
    p_titolo VARCHAR(100),
    p_descrizione TEXT,
    p_priorita priorita_enum,
    p_tipo tipo_enum,
    p_creatore VARCHAR(50),
    p_assegnatario VARCHAR(50),
    p_immagine TEXT
) RETURNS TABLE(issue_id BIGINT, messaggio TEXT) AS $$
DECLARE
    v_issue_id BIGINT;
    v_peso INT;
BEGIN
    INSERT INTO issue (titolo, descrizione, priorita, tipo, creatoreUsername, assegnatarioUsername, immagineUrl, dataCreazione, risolto)
    VALUES (p_titolo, p_descrizione, p_priorita, p_tipo, p_creatore, p_assegnatario, p_immagine, timezone('Europe/Rome', NOW()::timestamptz), FALSE)
    RETURNING id INTO v_issue_id;

    v_peso := CASE p_priorita
        WHEN 'LOW' THEN 1
        WHEN 'MEDIUM' THEN 2
        WHEN 'HIGH' THEN 3
        WHEN 'CRITICAL' THEN 4
    END;

    IF p_assegnatario IS NOT NULL THEN
        UPDATE account
        SET issueAssegnate = issueAssegnate + v_peso
        WHERE nomeUtente = p_assegnatario;

        INSERT INTO notifica (destinatarioUsername, messaggio, dataCreazione)
        VALUES (p_assegnatario, 'Ti è stata assegnata una nuova issue: "' || p_titolo || '"', timezone('Europe/Rome', NOW()::timestamptz));
    END IF;

    RETURN QUERY SELECT v_issue_id, 'Issue creata con successo'::TEXT;

EXCEPTION
    WHEN others THEN
        RETURN QUERY SELECT NULL::BIGINT, ('Errore: ' || SQLERRM)::TEXT;
END;
$$ LANGUAGE plpgsql;



CREATE OR REPLACE FUNCTION elimina_issue(
    p_issue_id BIGINT,
    p_richiedente VARCHAR
)
RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR) AS $$
DECLARE
    v_assegnatario VARCHAR(50);
    v_creatore VARCHAR(50);
    v_titolo VARCHAR(100);
    v_priorita priorita_enum;
    v_risolto BOOLEAN;
    v_ruolo_richiedente ruolo_enum;
BEGIN
    SELECT assegnatarioUsername, creatoreUsername, titolo, priorita, risolto
    INTO v_assegnatario, v_creatore, v_titolo, v_priorita, v_risolto
    FROM issue
    WHERE id = p_issue_id;

    IF NOT FOUND THEN
        RETURN QUERY SELECT false::BOOLEAN, 'Issue non trovata'::VARCHAR;
        RETURN;
    END IF;

    SELECT ruolo INTO v_ruolo_richiedente
    FROM account
    WHERE nomeUtente = p_richiedente;

    IF v_creatore != p_richiedente AND v_ruolo_richiedente != 'AMMINISTRATORE' THEN
        RETURN QUERY SELECT false::BOOLEAN, 'Non sei autorizzato a eliminare questa issue'::VARCHAR;
        RETURN;
    END IF;

    IF v_assegnatario IS NOT NULL AND v_risolto = FALSE THEN
        UPDATE account
        SET issueAssegnate = issueAssegnate -
            CASE v_priorita
                WHEN 'LOW' THEN 1
                WHEN 'MEDIUM' THEN 2
                WHEN 'HIGH' THEN 3
                WHEN 'CRITICAL' THEN 4
            END
        WHERE nomeUtente = v_assegnatario;
    END IF;

    IF v_assegnatario IS NOT NULL AND v_assegnatario != p_richiedente THEN
        INSERT INTO notifica (destinatarioUsername, messaggio, dataCreazione)
        VALUES (v_assegnatario, 'La issue "' || v_titolo || '" che ti era assegnata è stata eliminata da ' || p_richiedente, timezone('Europe/Rome', NOW()::timestamptz));
    END IF;

    IF v_creatore != p_richiedente THEN
        INSERT INTO notifica (destinatarioUsername, messaggio, dataCreazione)
        VALUES (v_creatore, 'La tua issue "' || v_titolo || '" è stata eliminata da ' || p_richiedente, timezone('Europe/Rome', NOW()::timestamptz));
    END IF;

    DELETE FROM issue WHERE id = p_issue_id;

    RETURN QUERY SELECT true::BOOLEAN, 'Issue eliminata con successo'::VARCHAR;

EXCEPTION
    WHEN others THEN
        RETURN QUERY SELECT false::BOOLEAN, ('Errore: ' || SQLERRM)::VARCHAR;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION risolvi_issue(
    p_issue_id BIGINT
)
RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR) AS $$
DECLARE
    v_risolto BOOLEAN;
    v_assegnatario VARCHAR(50);
    v_creatore VARCHAR(50);
    v_titolo VARCHAR(100);
    v_priorita priorita_enum;
BEGIN
    SELECT risolto, assegnatarioUsername, creatoreUsername, titolo, priorita
    INTO v_risolto, v_assegnatario, v_creatore, v_titolo, v_priorita
    FROM issue
    WHERE id = p_issue_id;

    IF NOT FOUND THEN
        RETURN QUERY SELECT false::BOOLEAN, 'Issue non trovata'::VARCHAR;
        RETURN;
    END IF;

    IF v_risolto THEN
        RETURN QUERY SELECT false::BOOLEAN, 'Issue già risolta'::VARCHAR;
        RETURN;
    END IF;

    UPDATE issue
    SET risolto = TRUE,
        dataRisoluzione = timezone('Europe/Rome', NOW()::timestamptz)
    WHERE id = p_issue_id;

    IF v_assegnatario IS NOT NULL THEN
        UPDATE account
        SET issueAssegnate = issueAssegnate -
            CASE v_priorita
                WHEN 'LOW' THEN 1
                WHEN 'MEDIUM' THEN 2
                WHEN 'HIGH' THEN 3
                WHEN 'CRITICAL' THEN 4
            END
        WHERE nomeUtente = v_assegnatario;
    END IF;

    INSERT INTO notifica (destinatarioUsername, messaggio, dataCreazione)
    VALUES (v_creatore, 'La tua issue "' || v_titolo || '" è stata risolta da ' || v_assegnatario, timezone('Europe/Rome', NOW()::timestamptz));

    RETURN QUERY SELECT true::BOOLEAN, 'Issue risolta con successo'::VARCHAR;

EXCEPTION
    WHEN others THEN
        RETURN QUERY SELECT false::BOOLEAN, ('Errore: ' || SQLERRM)::VARCHAR;
END;
$$ LANGUAGE plpgsql;


