CREATE TYPE ruolo_enum AS ENUM ('UTENTE', 'AMMINISTRATORE');

CREATE TABLE account (
    nomeUtente VARCHAR(50) PRIMARY KEY,
    password VARCHAR(50) NOT NULL,
    nome VARCHAR(20) NOT NULL,
    cognome VARCHAR(20) NOT NULL,
    email VARCHAR(50) NOT NULL UNIQUE,
    ruolo ruolo_enum NOT NULL DEFAULT 'UTENTE',
    avatar VARCHAR(50) NOT NULL
);


CREATE OR REPLACE FUNCTION crea_account(
    p_nomeUtente VARCHAR,
    p_password VARCHAR,
    p_nome VARCHAR,
    p_cognome VARCHAR,
    p_email VARCHAR,
    p_ruolo ruolo_enum,
    p_avatar VARCHAR
)
RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR) AS $$
BEGIN
    INSERT INTO account (nomeUtente, password, nome, cognome, email, ruolo, avatar)
    VALUES (p_nomeUtente, p_password, p_nome, p_cognome, p_email, p_ruolo, p_avatar);

    RETURN QUERY SELECT true::BOOLEAN, 'Account creato con successo'::VARCHAR;

EXCEPTION
    WHEN unique_violation THEN
        RETURN QUERY SELECT false::BOOLEAN, 'NomeUtente o Email già esistente'::VARCHAR;
    WHEN others THEN
        RETURN QUERY SELECT false::BOOLEAN, ('Errore: ' || SQLERRM)::VARCHAR;
END;

CREATE OR REPLACE FUNCTION login(
    p_nomeUtente VARCHAR,
    p_password VARCHAR
)
RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR, ruolo ruolo_enum) AS $$
BEGIN
    IF EXISTS (SELECT 1 FROM account WHERE nomeUtente = p_nomeUtente AND password = p_password) THEN
        RETURN QUERY
        SELECT
            true::BOOLEAN,
            'Login effettuato con successo'::VARCHAR,
            a.ruolo
        FROM account a
        WHERE a.nomeUtente = p_nomeUtente;
    ELSE
        RETURN QUERY
        SELECT
            false::BOOLEAN,
            'NomeUtente o password errati'::VARCHAR,
            NULL::ruolo_enum;
    END IF;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION get_all_accounts()
RETURNS TABLE(
    nomeUtente VARCHAR,
    password VARCHAR,
    nome VARCHAR,
    cognome VARCHAR,
    email VARCHAR,
    ruolo ruolo_enum,
    avatar VARCHAR
) AS $$
BEGIN
    RETURN QUERY
    SELECT
        a.nomeUtente,
        a.password,
        a.nome,
        a.cognome,
        a.email,
        a.ruolo,
        a.avatar
    FROM account a
    ORDER BY a.ruolo DESC, a.nomeUtente ASC;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION elimina_account(
    p_nomeUtente VARCHAR
)
RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR) AS $$
BEGIN
    DELETE FROM account WHERE nomeUtente = p_nomeUtente;

    IF FOUND THEN
        RETURN QUERY SELECT true::BOOLEAN, 'Account eliminato con successo'::VARCHAR;
    ELSE
        RETURN QUERY SELECT false::BOOLEAN, 'Account non trovato'::VARCHAR;
    END IF;

EXCEPTION
    WHEN others THEN
        RETURN QUERY SELECT false::BOOLEAN, ('Errore: ' || SQLERRM)::VARCHAR;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION modifica_account(
    p_nomeUtente VARCHAR,
    p_password VARCHAR,
    p_nome VARCHAR,
    p_cognome VARCHAR,
    p_email VARCHAR,
    p_avatar VARCHAR
)
RETURNS TABLE(successo BOOLEAN, messaggio VARCHAR) AS $$
BEGIN
    UPDATE account
    SET
        password = COALESCE(NULLIF(p_password, ''), password),
        nome = COALESCE(NULLIF(p_nome, ''), nome),
        cognome = COALESCE(NULLIF(p_cognome, ''), cognome),
        email = COALESCE(NULLIF(p_email, ''), email),
        avatar = COALESCE(NULLIF(p_avatar, ''), avatar)
    WHERE nomeUtente = p_nomeUtente;

    IF FOUND THEN
        RETURN QUERY SELECT true::BOOLEAN, 'Account modificato con successo'::VARCHAR;
    ELSE
        RETURN QUERY SELECT false::BOOLEAN, 'Account non trovato'::VARCHAR;
    END IF;

EXCEPTION
    WHEN unique_violation THEN
        RETURN QUERY SELECT false::BOOLEAN, 'Email già esistente'::VARCHAR;
    WHEN others THEN
        RETURN QUERY SELECT false::BOOLEAN, ('Errore: ' || SQLERRM)::VARCHAR;
END;
$$ LANGUAGE plpgsql;
